---
import { Image } from 'astro:assets';

export interface Props {
  imageUrl: string;
  description: string;
  imageWidth: number;
  imageHeight: number;
}

const {
  imageUrl, 
  description, 
  imageWidth,
  imageHeight,
} = Astro.props
---

<article
  class="flex items-center justify-center rounded-sm shadow-md overflow-hidden
    transition-shadow duration-300 cursor-pointer
    hover:border-gray-700 justify-center
    w-full not-prose"
  data-trigger="view-image" 
  data-imageurl={imageUrl}
  data-imagewidth={imageWidth}
  data-imageheight={imageHeight}
  data-description={description}
>
  <Image
    class={"max-w-full max-h-full object-contain transition-transform duration-300"}
    src={imageUrl}
    alt={description}
    width={imageWidth}
    height={imageHeight}
    format="webp"
    loading="lazy"
  />
</article>
